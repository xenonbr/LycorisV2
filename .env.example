# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no Vercel.
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...chave-anon-public
# Chave service_role: SECRETA, nunca use com prefixo NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=eyJ...chave-service-role

# Senha padrão Nível 1 do painel /admin (troque!)
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Senha Mestra Nível 2 (Administrador Principal)
MASTER_ADMIN_PASSWORD=troque-por-uma-senha-mestra-forte

# Segredo HMAC para assinatura dos tokens de sessão administrativa
ADMIN_TOKEN_SECRET=gere-uma-string-aleatoria-longa-aqui

# Opcional: segredo para webhooks externos enviarem fotos (header x-webhook-secret)
WEBHOOK_SECRET=
